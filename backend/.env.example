# backend/.env.example
#
# Copy this file to backend/.env for local development.
# NEVER commit .env — it is listed in .gitignore.
#
# Production values are set in Render's Environment Variables panel only.

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset locally to use the SQLite fallback (backend/reviews.db).
# On Render this is injected automatically from the linked PostgreSQL instance.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Admin API Key ─────────────────────────────────────────────────────────────
# Must be a strong, randomly-generated secret in production.
# The application refuses to start in production if this value is still the default.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=change-me-in-production

# ── CORS allowed origins ──────────────────────────────────────────────────────
# Comma-separated list.  In production set to the real frontend domains.
# Example production value:
#   ALLOWED_ORIGINS=https://mindinfluencer.in,https://www.mindinfluencer.in,https://mindinfluencer-57ee1.web.app
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
