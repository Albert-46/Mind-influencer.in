# Copy this file to .env and fill in real values before running.
# Load it with:  set -a && source .env && set +a  (Linux/Mac)
#               or use python-dotenv in app.py

# Flask
FLASK_SECRET_KEY=replace-with-a-random-50-char-string
FLASK_DEBUG=false

# JWT (admin tokens)
JWT_SECRET_KEY=replace-with-another-random-50-char-string
JWT_EXPIRY_HOURS=8

# Database (leave blank for SQLite — the default)
# DATABASE_URL=postgresql://user:password@localhost:5432/mind_influencer

# CORS — comma-separated list of allowed frontend origins
# Use * during development only.
CORS_ORIGINS=https://mindinfluencer.in,https://www.mindinfluencer.in
